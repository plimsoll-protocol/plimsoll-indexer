# Postgres connection string. Locally: go run ./cmd/devdb
DATABASE_URL=postgres://plimsoll:plimsoll@localhost:54329/plimsoll?sslmode=disable
PORT=8080

STELLAR_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# A second, independent Horizon. Before the poster signs a supply figure on
# chain it asks this one too, and refuses to post if the two disagree about the
# same ledger. Must be run by someone else to be worth anything: a second URL
# onto the same instance agrees with itself. Empty disables the check.
HORIZON_CHECK_URL=

# From plimsoll-contracts/deployments/testnet.json
COVERAGE_LEDGER_ID=CC2QQ7R4FLPHZP7KA5AO4IASXXICTG6N4GQXCXITTEBNYQEYTYXKMN4D
REPORTER_REGISTRY_ID=CCZCBR7MGSW5LGIEUQR5TU5Z7JQWBDEESB3RGPTRPMCBUMOISRPY7GOB
# First ledger to ingest. Clamped to RPC's ~7 day retention window.
START_LEDGER=5034380

# Secret seed of an account registered as SupplyPoster. Leave empty to run read-only.
SUPPLY_POSTER_SECRET=

INGEST_INTERVAL=10s
POST_INTERVAL=15m
REPOST_AFTER=6h
TOML_INTERVAL=6h
CORS_ORIGINS=*
LOG_LEVEL=info

# Request this URL every KEEP_AWAKE_INTERVAL so hosts that sleep idle services
# (Render free tier) keep the poster running. Defaults to
# $RENDER_EXTERNAL_URL/healthz on Render, off elsewhere. "none" turns it off.
KEEP_AWAKE_URL=
KEEP_AWAKE_INTERVAL=10m
