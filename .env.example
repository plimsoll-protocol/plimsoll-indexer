# Set to production in a deployment: the local .env.local overlay is then
# ignored. Leave empty for local development.
GO_ENV=

# Postgres connection string. Locally: go run ./cmd/devdb
DATABASE_URL=postgres://plimsoll:plimsoll@localhost:54329/plimsoll?sslmode=disable
PORT=8080

# Network preset: testnet (default), mainnet or standalone. It sets the three
# defaults below; set any of them to override. mainnet has no default RPC:
# SDF runs no public Soroban RPC for it, so STELLAR_RPC_URL is required there.
# standalone targets stellar/quickstart on localhost:8000.
NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# A second, independent Horizon. Before the poster signs a supply figure on
# chain it asks this one too, and refuses to post if the two disagree about the
# same ledger. Must be run by someone else to be worth anything: a second URL
# onto the same instance agrees with itself. Empty disables the check.
HORIZON_CHECK_URL=

# From plimsoll-contracts/deployments/testnet.json
COVERAGE_LEDGER_ID=CC2QQ7R4FLPHZP7KA5AO4IASXXICTG6N4GQXCXITTEBNYQEYTYXKMN4D
REPORTER_REGISTRY_ID=CCZCBR7MGSW5LGIEUQR5TU5Z7JQWBDEESB3RGPTRPMCBUMOISRPY7GOB
# First ledger to ingest. Clamped to RPC's ~7 day retention window.
START_LEDGER=5034380

# Secret seed of an account registered as SupplyPoster. Leave empty to run read-only.
SUPPLY_POSTER_SECRET=

# Optional webhook administration. Configure both values to enable authenticated
# webhook registration and delivery. Generate the encryption key with:
#   openssl rand -base64 32
WEBHOOK_ADMIN_TOKEN=
WEBHOOK_ENCRYPTION_KEY=

INGEST_INTERVAL=10s
POST_INTERVAL=15m
REPOST_AFTER=6h
TOML_INTERVAL=6h
CORS_ORIGINS=*
LOG_LEVEL=info

# Fee ceiling: refuse to sign a transaction whose total fee (inclusion + resource)
# exceeds this many stroops. During surge pricing the minimum inclusion fee
# alone may not get included, and an oversized resource fee simulation would be
# signed without question. 0 means no ceiling.
MAX_FEE_STROOPS=10000000

# Inclusion fee bid in stroops (defaults to MinBaseFee = 100). Raise this
# during surge pricing to improve inclusion chances.
INCLUSION_FEE=

# Percentage headroom added to the simulated resource fee before signing.
# E.g. 20 pads the resource fee by 20 %. 0 means no margin.
RESOURCE_FEE_MARGIN_PCT=

# Warn when the poster account's XLM balance falls below this many stroops.
# 0 (the default) disables the check.
POSTER_LOW_BALANCE_STROOPS=10000000

# Request this URL every KEEP_AWAKE_INTERVAL so hosts that sleep idle services
# (Render free tier) keep the poster running. Defaults to
# $RENDER_EXTERNAL_URL/healthz on Render, off elsewhere. "none" turns it off.
KEEP_AWAKE_URL=
KEEP_AWAKE_INTERVAL=10m
